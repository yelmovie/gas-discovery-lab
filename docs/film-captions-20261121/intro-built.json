   ],
   "who": "에어",
   "text": "[공기 코어]가 멈추자 연구시설도 하나둘 멈췄어요."
  },
  {
   "s": 4.43,
   "e": 7.99,
   "speech": [
    4.58,
    7.64
   ],
   "who": "에어",
   "text": "여우 에어와 함께 고장 난 마을을 살펴볼까요?"
  },
  {
   "s": 8.6,
   "e": 12.56,
   "speech": [
    8.75,
    12.21
   ],
   "who": "루미",
   "text": "관을 잇고, 무게를 재고, 부피를 비교해요."
  },
  {
   "s": 12.7,
   "e": 17.48,
   "speech": [
    12.85,
    17.13
   ],
   "who": "루미",
   "text": "다섯 연구시설을 도울 때마다 내 [탐구 기록]과 배지가 생겨요."
  },
  {
   "s": 18.29,
   "e": 22.74,
   "speech": [
    18.44,
    22.54
   ],
   "who": "포포",
   "text": "모은 증거와 직접 만든 [공기 장치]로 중앙 코어를 움직여요."
  },
  {
   "s": 22.79,
   "e": 26.77,
   "speech": [
    22.94,
    26.42
   ],
   "who": "포포",
   "text": "모험 끝에는 나만의 연구 기록과 인증서가 남아요."
  },
  {
   "s": 27.43,
   "e": 30.2,
   "speech": [
    27.58,
    30.06
   ],
   "who": "에어",
   "text": "멈춘 [바람의 비밀]을 함께 찾아 줄래요?"
  },
  {
   "s": 30.25,
   "e": 33.89,
   "speech": [
    30.4,
    33.54
   ],
   "who": "에어",
   "text": "친구의 도움이 꼭 필요해요. 같이 출발해요!"
  }
 ]
}